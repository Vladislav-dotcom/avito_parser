# Скопировать в /etc/avito-parser-deploy-hook.env, chmod 600.
# Секрет webhook (тот же, что в GitHub → Webhooks → Secret):
GITHUB_WEBHOOK_SECRET=

# Ветка, по push в которую выполняется редеплой:
DEPLOY_BRANCH=main

# Корень репозитория на сервере:
DEPLOY_ROOT=/opt/avito_parser

# Обёртка с flock (по умолчанию совпадает с путём в репо):
# REDEPLOY_WRAPPER=/opt/avito_parser/deploy/avito-parser-redeploy-wrapper.sh

# Юниты systemd через пробел (имена без .service). Прод по README:
SYSTEMD_RESTART_UNITS=avito-web avito-worker avito-cleanup

# Порт слушателя (9847 занят под ai_parser на том же VPS):
WEBHOOK_LISTEN_PORT=9848
WEBHOOK_LISTEN_HOST=127.0.0.1

# Опционально:
# REDEPLOY_LOCK_FILE=/var/run/avito-parser-redeploy.lock
# REDEPLOY_LOG_FILE=/var/log/avito-parser-redeploy.log
